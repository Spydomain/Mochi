+TEST(AWDLSharedBootstrap, HasEmptySlotsAndOnlyTheRealChannel) {
+	const struct awdl_chan channels[] = {CHAN_OPCLASS_36, CHAN_OPCLASS_44, CHAN_OPCLASS_149};
+	for (const auto &chan : channels) {
+		struct awdl_chan sequence[AWDL_CHANSEQ_LENGTH];
+		awdl_chanseq_init_shared(sequence, &chan);
+		EXPECT_EQ(5, awdl_chanseq_count_chan(sequence, AWDL_CHAN_ENC_OPCLASS,
+		                                      chan.opclass.chan_num));
+		EXPECT_EQ(chan.opclass.chan_num, sequence[0].opclass.chan_num);
+		for (const auto &slot : sequence)
+			EXPECT_TRUE(slot.opclass.chan_num == 0 || slot.opclass.chan_num == chan.opclass.chan_num);
+	}
+}
