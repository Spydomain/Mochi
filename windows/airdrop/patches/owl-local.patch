+void awdl_chanseq_init_shared(struct awdl_chan *seq, const struct awdl_chan *chan) {
+	for (int i = 0; i < AWDL_CHANSEQ_LENGTH; i++) {
+		/* Slot 0 is infrastructure; the paired social slots follow the
+		 * shape observed on the peer. Never advertise an unreachable channel. */
+		seq[i] = (i == 0 || i == 6 || i == 7 || i == 14 || i == 15)
+		         ? *chan : (struct awdl_chan) CHAN_NULL;
+	}
+}
