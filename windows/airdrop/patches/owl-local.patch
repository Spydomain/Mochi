diff --git a/daemon/io.c b/daemon/io.c
index 46c8cc7..8f6a052 100644
--- a/daemon/io.c
+++ b/daemon/io.c
@@ -384,8 +384,13 @@ int wlan_send(const struct io_state *state, const uint8_t *buf, int len) {
 		return -EINVAL;
 	err = pcap_inject(state->wlan_handle, buf, len);
 	if (err < 0) {
+		int saved_errno = errno;
+		/* The monitor socket is nonblocking. A full kernel TX queue is
+		 * temporary; callers must retain the frame and retry it. */
+		if (saved_errno == EAGAIN || saved_errno == EWOULDBLOCK)
+			return -EAGAIN;
 		log_error("unable to inject packet (%s)", pcap_geterr(state->wlan_handle));
-		return err;
+		return saved_errno ? -saved_errno : -EIO;
 	}
 	return 0;
 }
diff --git a/src/rx.c b/src/rx.c
index 4581ae5..d05d39e 100644
--- a/src/rx.c
+++ b/src/rx.c
@@ -321,7 +321,12 @@ int awdl_rx_action(const struct buf *frame, signed char rssi, uint64_t tsft,
 		buf_strip(frame, len);
 	}
 
-	if (buf_len(frame) > 0) {
+	/* Recent iPhones append two bytes after the last complete AWDL TLV.
+	 * read_tlv() cannot consume them (a TLV header needs three bytes). Treat
+	 * only that observed two-byte trailer as padding; otherwise a malformed
+	 * action frame must still be rejected. Rejecting every MIF here leaves
+	 * sent_mif unset, so the peer never becomes valid for discovery. */
+	if (buf_len(frame) > 0 && buf_len(frame) != 2) {
 		log_debug("awdl_action: unexpected bytes (%d) at end of frame", buf_len(frame));
 		return RX_UNEXPECTED_FORMAT;
 	}
