 int awdl_is_multicast_eaw(const struct awdl_state *state, uint64_t now) {
 	uint16_t slot = awdl_sync_current_eaw(now, &state->sync) % AWDL_CHANSEQ_LENGTH;
+	/* A shared radio cannot follow the usual multicast channels in slots
+	 * 0/10. Send discovery in the windows we actually share with the peer,
+	 * not on our fixed physical channel while the peer is elsewhere. */
+	if (state->channel.strategy == AWDL_CHANSEQ_INTERSECT)
+		return awdl_chan_num(state->channel.sequence[slot], state->channel.enc) != 0;
 	return slot == 0 || slot == 10;
 }
 
