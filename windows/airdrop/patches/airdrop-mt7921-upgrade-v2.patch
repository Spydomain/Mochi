+start_receiver_wake() {
+  # BlueZ owns the advertisement; never reset the shared Bluetooth controller.
+  # Keep it in the receiver service's cgroup so switching AirDrop off removes
+  # it even when a parent process is killed unexpectedly.
+  if [ -n "${RX_WAKE_PID:-}" ] && kill -0 "$RX_WAKE_PID" 2>/dev/null; then
+    return 0
+  fi
+  local script="$REPO/tools/blewake-dbus.py"
+  if [ -f "$script" ] && command -v python3 >/dev/null 2>&1; then
+    python3 "$script" >> "$LOG" 2>&1 &
+    RX_WAKE_PID=$!
+  fi
+}
+
+stop_receiver_wake() {
+  if [ -n "${RX_WAKE_PID:-}" ]; then
+    kill "$RX_WAKE_PID" 2>/dev/null || true
+    wait "$RX_WAKE_PID" 2>/dev/null || true
+    RX_WAKE_PID=""
+  fi
+}
