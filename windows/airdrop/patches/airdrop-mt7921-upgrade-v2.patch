--- a/daemon/airdropd
+++ b/daemon/airdropd
@@ -625,6 +625,7 @@
   # to be able to end the process with the card half torn down - in exclusive
   # mode that is "Wi-Fi gone until you fix it by hand".
   trap '' INT TERM
+  stop_receiver_wake
   [ "$EXCL" = 1 ] && set_state restoring "bringing the Wi-Fi back"
