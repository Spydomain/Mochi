diff --git a/daemon/airdrop-helper b/daemon/airdrop-helper
index 2d82eba..3f55d7b 100755
--- a/daemon/airdrop-helper
+++ b/daemon/airdrop-helper
@@ -192,6 +192,51 @@ ap_channel() {
   iw dev "$IFACE" info 2>/dev/null | grep -oP 'channel \K[0-9]+'
 }
 
+# Firmware runtime PM and the managed station's 802.11 power saving are
+# separate controls. Keep the station awake while it shares the radio with
+# AWDL, then restore the user's original setting without reassociating.
+COEX_STATE_DIR=/run/airdrop-coexistence
+wifi_coexistence_begin() {
+  local saved previous
+  [ -n "$IFACE" ] || return 1
+  case "$IFACE" in *[!a-zA-Z0-9_.-]*) return 1 ;; esac
+  if [ ! -e "$COEX_STATE_DIR" ]; then
+    mkdir -m 700 "$COEX_STATE_DIR" || return 1
+  fi
+  if [ -L "$COEX_STATE_DIR" ] || [ ! -d "$COEX_STATE_DIR" ] \
+     || [ "$(stat -c '%u %a' "$COEX_STATE_DIR")" != '0 700' ]; then
+    echo 'airdrop-helper: unsafe coexistence state directory' >&2
+    return 1
+  fi
+  saved="$COEX_STATE_DIR/$IFACE.powersave"
+  if [ ! -e "$saved" ]; then
+    previous=$(iw dev "$IFACE" get power_save | awk '/Power save:/{print $3}')
+    case "$previous" in on|off) ;; *) return 1 ;; esac
+    (umask 077; printf '%s\n' "$previous" > "$saved") || return 1
+  fi
+  if [ -L "$saved" ] || [ ! -f "$saved" ]; then return 1; fi
+  IFS= read -r previous < "$saved" || return 1
+  case "$previous" in on|off) ;; *) return 1 ;; esac
+  iw dev "$IFACE" set power_save off
+}
+
+wifi_coexistence_end() {
+  local saved previous
+  [ -n "$IFACE" ] || return 0
+  case "$IFACE" in *[!a-zA-Z0-9_.-]*) return 1 ;; esac
+  saved="$COEX_STATE_DIR/$IFACE.powersave"
+  [ -e "$saved" ] || return 0
+  if [ -L "$COEX_STATE_DIR" ] || [ -L "$saved" ] \
+     || [ "$(stat -c '%u %a' "$COEX_STATE_DIR")" != '0 700' ]; then return 1; fi
+  IFS= read -r previous < "$saved" || return 1
+  case "$previous" in on|off) ;; *) return 1 ;; esac
+  if iw dev "$IFACE" set power_save "$previous"; then
+    rm -f -- "$saved"
+  else
+    return 1
+  fi
+}
+
 case "${1:-}" in
   ap-channel)
     ap_channel
@@ -216,6 +261,7 @@ case "${1:-}" in
       echo 0 > "$MT76/runtime-pm" 2>/dev/null
       echo 0 > "$MT76/deep-sleep" 2>/dev/null
     fi
+    wifi_coexistence_begin || exit 1
     printf '{"iface":"%s","mon":"%s","active":%s,"chan":%s}\n' \
       "$IFACE" "$MON" \
       "$(ip link show $MONA >/dev/null 2>&1 && echo true || echo false)" \
@@ -337,6 +383,7 @@ EOF
 
     echo 0 > "$MT76/runtime-pm" 2>/dev/null
     echo 0 > "$MT76/deep-sleep" 2>/dev/null
+    wifi_coexistence_begin || exit 1
     printf '{"go":"%s","mon":"%s","ackvif":"%s","chan":%s}\n' \
       "$GO" "$MON" "$ACKVIF" "$chan"
     ;;
@@ -373,6 +420,7 @@ EOF
     rm -f "$GO_CONF"
     echo 1 > "$MT76/runtime-pm" 2>/dev/null
     echo 1 > "$MT76/deep-sleep" 2>/dev/null
+    wifi_coexistence_end || exit 1
     echo '{"ok":true}'
     ;;
 
@@ -568,6 +616,7 @@ EOF
     iw dev $MON del 2>/dev/null
     echo 1 > "$MT76/runtime-pm" 2>/dev/null
     echo 1 > "$MT76/deep-sleep" 2>/dev/null
+    wifi_coexistence_end || exit 1
     # Deliberately does NOT touch $IFACE, NetworkManager or wpa_supplicant.
     # Nothing here ever took them down, and bouncing a working association on
     # the way out is the exact outage this design exists to avoid (§38).
@@ -600,6 +649,7 @@ EOF
         esac
       done
     fi
+    wifi_coexistence_end || exit 1
     echo '{"ok":true}'
     ;;
 
